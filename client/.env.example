# Vite solo expone al navegador las variables con prefijo VITE_
# En desarrollo el cliente llama a /api en el mismo origen y el proxy de
# Vite (ver vite.config.ts) lo reenvia al backend. Esta variable solo se
# usa en los builds de produccion.
VITE_API_URL=http://localhost:4000
VITE_MP_PUBLIC_KEY=
